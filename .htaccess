RewriteEngine On
RewriteCond %{HTTP_HOST} ^fuzzyplan\.madshorn\.dk$
RewriteCond %{REQUEST_URI} !^/fuzzyplan\.madshorn\.dk
RewriteRule ^(.*)$ fuzzyplan.madshorn.dk/$1 [L]

RewriteCond %{HTTP_HOST} ^kogebog\.madshorn\.dk$
RewriteCond %{REQUEST_URI} !^/kogebog\.madshorn\.dk
RewriteRule ^(.*)$ kogebog.madshorn.dk/$1 [L]

RewriteCond %{HTTP_HOST} ^cookbook\.madshorn\.dk$
RewriteCond %{REQUEST_URI} !^/cookbook\.madshorn\.dk
RewriteRule ^(.*)$ cookbook.madshorn.dk/$1 [L]

RewriteCond %{HTTP_HOST} ^niff\.madshorn\.dk$
RewriteCond %{REQUEST_URI} !^/niff\.madshorn\.dk
RewriteRule ^(.*)$ niff.madshorn.dk/$1 [L]

RewriteCond %{HTTP_HOST} ^fryser\.madshorn\.dk$
RewriteCond %{REQUEST_URI} !^/fryser\.madshorn\.dk
RewriteRule ^(.*)$ fryser.madshorn.dk/$1 [L]

ErrorDocument 404 /error/404.html
